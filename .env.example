# Supabase (optional). Without these the app runs with a local mock account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord Rich Presence (desktop): Application ID from discord.com/developers
VITE_DISCORD_APP_ID=

# Yandex Music. Built into the app when set (CI: the VITE_YANDEX_MUSIC_TOKEN repository variable;
# anyone can read it out of a public build). A token entered in Settings → Sources wins over it.
# Search works without it. Full tracks need an OAuth token issued to the Yandex Music
# app (its music scopes) and a Plus subscription; otherwise Yandex serves 30-second previews.
VITE_YANDEX_MUSIC_TOKEN=

# Extra browser origins allowed to call the local API (comma-separated), e.g. a separately hosted web build.
# SONARA_ORIGINS=https://sonara.example.com
