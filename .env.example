# Supabase (optional). Without these the app runs with a local mock account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord Rich Presence (desktop): Application ID from discord.com/developers
VITE_DISCORD_APP_ID=

# Yandex Music (dev only; in the apps enter it in Settings → Sources, it is never built in).
# Search works without it. Full tracks need an OAuth token issued to the Yandex Music
# app (its music scopes) and a Plus subscription; otherwise Yandex serves 30-second previews.
VITE_YANDEX_MUSIC_TOKEN=
