# Supabase (optional). Without these the app runs with a local mock account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord Rich Presence (desktop): Application ID from discord.com/developers
VITE_DISCORD_APP_ID=

# Yandex Music: enter the token in Settings → Sources. It is not built into release
# builds (anyone can read a token out of a public app). Search works without it.

# Extra browser origins allowed to call the local API (comma-separated), e.g. a separately hosted web build.
# SONARA_ORIGINS=https://sonara.example.com
