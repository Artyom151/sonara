# Supabase (optional). Without these the app runs with a local mock account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord Rich Presence (desktop): Application ID from discord.com/developers
VITE_DISCORD_APP_ID=

# Yandex Music (optional): search works without it. An OAuth token issued to the Yandex Music app
# (with its music scopes) plus a Plus subscription plays tracks straight from Yandex; otherwise
# tracks play through the matching YouTube recording.
VITE_YANDEX_MUSIC_TOKEN=
