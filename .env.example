# Supabase (optional). Without these the app runs with a local mock account.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Discord Rich Presence (desktop): Application ID from discord.com/developers
VITE_DISCORD_APP_ID=

# Yandex Music: OAuth token of a Yandex account (without Plus only 30-second previews play).
VITE_YANDEX_MUSIC_TOKEN=
# VK Music: access token of the Kate Mobile / VK Android client (other tokens get no audio).
VITE_VK_TOKEN=
