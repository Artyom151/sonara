{
  "name": "sonara",
  "version": "1.1.23",
  "description": "Sonara — music streaming client (SoundCloud + YouTube)",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm dev:server\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/check-env.mjs && node scripts/gen-shaders.mjs --check && node scripts/build-pot.mjs && vite build",
    "shaders": "node scripts/gen-shaders.mjs",
    "build:pot": "node scripts/build-pot.mjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/artists.test.ts tests/lyrics.test.ts tests/potoken.test.ts tests/release.test.ts tests/updates.test.ts tests/shaders.test.ts tests/headphones.test.ts tests/equalizer.test.ts",
    "icons": "node scripts/gen-icons.mjs && node scripts/gen-brand.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:build": "pnpm build && cap sync android && node scripts/android-gradle.mjs assembleRelease",
    "android:debug": "pnpm build && cap sync android && node scripts/android-gradle.mjs assembleDebug",
    "smoke:android": "node scripts/smoke-android.mjs",
    "android:gradle": "node scripts/android-gradle.mjs",
    "android:keystore": "node scripts/android-keystore.mjs"
  },
  "author": "Sonara",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@material/material-color-utilities": "^0.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "bgutils-js": "4.0.3",
    "deezer-api-ts": "^1.2.4",
    "framework7-icons": "^5.0.5",
    "hls.js": "^1.7.3",
    "hono": "^4.13.13",
    "jsdom": "^30.1.2",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "youtube-music-ts-api": "^1.8.4",
    "youtubei.js": "^18.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true
}
